# Copy this file to .env.local and fill in your provider details.

# Audius — primary playable music source.
# Create an app at https://audius.co/settings -> "Manage Your Apps", or https://api.audius.co/plans
# Use the read-only API Key. Never put the API Secret in a frontend environment variable.
VITE_AUDIUS_API_KEY=your_audius_api_key

# Spotify — secondary discovery and embeds.
# Create an app at https://developer.spotify.com/dashboard
# Add the exact redirect URI below in the app's Redirect URIs settings.
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/

# For a deployed build, use the deployed URL instead. Register BOTH exact URIs
# in the Spotify Developer Dashboard (Development Mode accounts must also be allowlisted):
# VITE_SPOTIFY_REDIRECT_URI=https://vyra-azure-iota.vercel.app/

# PKCE runs entirely in the browser. Never add a Spotify client secret or token here.

# Lyrics — optional public LRCLIB client identification.
# Anonymous browser access works with VYRA's X-User-Agent header. Register at
# https://lrclib.net/developers only if you need a higher rate limit; the ID is public.
# VITE_LRCLIB_APP_ID=your_public_lrclib_app_id
