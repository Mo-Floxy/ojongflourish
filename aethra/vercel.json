{
  "version": 2,
  "framework": "vite",
  "installCommand": "npm install --include=dev --no-audit --no-fund",
  "buildCommand": "npm run build -w client",
  "outputDirectory": "client/dist",
  "cleanUrls": true,
  "env": {
    "VITE_API_URL": "/api"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
