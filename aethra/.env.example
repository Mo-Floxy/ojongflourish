# Copy to server/.env and client/.env.local as indicated below.
# NEVER commit real secrets.

# ---------- Server (server/.env) ----------
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=aethra_db
# Remote MySQL-compatible providers usually require TLS. Auto-enabled for non-local hosts.
DB_SSL=true

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Password recovery
# dev  = reset links are returned in the API response (local development only)
# smtp = reset links are emailed using the SMTP settings below
MAIL_MODE=dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AETHRA <no-reply@aethra.local>"

# Chat AI provider: openai | groq | openrouter | together
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1200

# Image AI provider: openai | together | stability
IMAGE_PROVIDER=openai
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_BASE_URL=

# ---------- Client (client/.env.local) ----------
VITE_API_URL=http://localhost:4000/api
